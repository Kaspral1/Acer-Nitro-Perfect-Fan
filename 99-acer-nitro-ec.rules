# Zezwala grupie acer_nitro_perfect_fan na zapis do rejestrów PWM sterownika acer_nitro_ec.
# Dzięki temu daemon działa jako zwykły użytkownik (User=acer_nitro_perfect_fan w unitce)
# i nie potrzebuje roota. Reguła odpala się przy każdym załadowaniu modułu.
ACTION=="add", SUBSYSTEM=="hwmon", ATTR{name}=="acer_nitro_ec", \
    RUN+="/bin/sh -c 'chgrp acer_nitro_perfect_fan /sys%p/pwm1 /sys%p/pwm1_enable /sys%p/pwm2 /sys%p/pwm2_enable && chmod g+w /sys%p/pwm1 /sys%p/pwm1_enable /sys%p/pwm2 /sys%p/pwm2_enable'"

# Czerwone podświetlenie (EC 0x31) — atrybuty na urządzeniu platformy.
# Zapisuje je GUI (zwykły użytkownik), więc dostają grupę katalogu /etc/nitro-fan,
# czyli grupę użytkownika, który uruchomił install.sh. Bez zapisu dla wszystkich (0666).
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="acer-nitro-ec", \
    RUN+="/bin/sh -c 'chgrp --reference=/etc/nitro-fan /sys/devices/platform/acer-nitro-ec/kbd_backlight /sys/devices/platform/acer-nitro-ec/kbd_timeout 2>/dev/null; chmod 0664 /sys/devices/platform/acer-nitro-ec/kbd_backlight /sys/devices/platform/acer-nitro-ec/kbd_timeout 2>/dev/null; true'"
